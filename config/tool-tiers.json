{
  "_description": "Single source of truth for tool UX across the server (tool_presentation.py, the served status line), web and iOS timeline rendering. Regenerate TS/Swift via scripts/generate/tool_tiers.py. Vocabulary contract: providers name the same action differently (Bash, exec_command, Shell, bash, run_command), so every entry maps a raw provider tool name to one canonical `label` from `labels` (Shell, Read, Edit, Write, Notebook, Search, List, Fetch, Web search, Agent, Plan, Ask, Wait, Result, Tool) and a present-tense `status` phrase that the served session status line shows while that tool runs (\"Running a command\"). Lookup is exact name first, then case-insensitive, on every surface, so one entry covers Bash and bash; list only names that differ ignoring case. Swarm board tools (post_message, read_board, swarm_note) are Agent: they coordinate subagents. A name not listed here is shown as itself (\"Using <name>\"); an MCP tool mcp__ns__method is shown by its method.",
  "_labels": "Canonical labels and the default status phrase for each. An entry's `status` may be more specific (\"Messaging a subagent\") but its `label` must be a key here; the generator refuses anything else.",
  "labels": {
    "Shell": "Running a command",
    "Read": "Reading files",
    "Edit": "Editing files",
    "Write": "Writing a file",
    "Notebook": "Editing a notebook",
    "Search": "Searching",
    "List": "Listing files",
    "Fetch": "Fetching a page",
    "Web search": "Searching the web",
    "Agent": "Running a subagent",
    "Plan": "Updating the plan",
    "Ask": "Asking a question",
    "Wait": "Waiting",
    "Result": "Returning a result",
    "Tool": "Using a tool"
  },
  "_tiers": {
    "noise": "Low-signal tools. Singleton renders as a demoted one-liner. Aggregation is controlled separately by `aggregate`.",
    "context": "Passive reads a user might care about specifically when alone (Read, WebFetch). Singleton = inline one-liner. File reads may still join exploration runs via `aggregate`.",
    "action": "State-changing or heavyweight work (Edit, Write, Bash, Task, remote ops). Always breaks exploration runs. Compact card UI."
  },
  "_aggregate": {
    "search": "Grep/find/codebase search-style calls. Join consecutive exploration runs.",
    "read": "File reads. Singleton stays context one-liner; 2+ with other eligible calls join a run.",
    "list": "Directory/glob listing. Join consecutive exploration runs.",
    "wait": "Successful polling/wait calls. Join consecutive wait runs.",
    "null": "Never joins an exploration run (web provenance, mutations, MCP default, unknown)."
  },
