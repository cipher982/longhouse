{
  "$comment": "Single source of truth for all LLM model configuration across Longhouse",

  "text": {
    "$comment": "Text/chat completion models (Zerg agent orchestration)",
    "tiers": {
      "TIER_1": "deepseek/deepseek-v4-flash",
      "TIER_2": "deepseek/deepseek-v4-flash",
      "TIER_3": "deepseek/deepseek-v4-flash"
    },
    "models": {
      "deepseek/deepseek-v4-flash": {
        "displayName": "DeepSeek v4 Flash (OpenRouter)",
        "provider": "openrouter",
        "tier": "TIER_1",
        "description": "DeepSeek v4 Flash via OpenRouter - standard text and automation lane",
        "baseUrl": "https://openrouter.ai/api/v1",
        "apiKeyEnvVar": "OPENROUTER_API_KEY",
        "capabilities": {
          "reasoning": true,
          "reasoningNone": true
        }
      }
    }
  },

  "realtime": {
    "$comment": "Realtime/voice models",
    "tiers": {
      "TIER_1": "gpt-4o-realtime-preview",
      "TIER_2": "gpt-4o-mini-realtime-preview"
    },
    "models": {
      "gpt-4o-realtime-preview": {
        "displayName": "GPT-4o Realtime",
        "provider": "openai",
        "tier": "TIER_1",
        "description": "Full capability realtime model"
      },
      "gpt-4o-mini-realtime-preview": {
        "displayName": "GPT-4o Mini Realtime",
        "provider": "openai",
        "tier": "TIER_2",
        "description": "Faster, cheaper realtime model"
      }
    },
    "aliases": {
      "gpt-realtime": "gpt-4o-realtime-preview",
      "gpt-4-realtime": "gpt-4o-realtime-preview"
    },
    "defaultVoice": "verse"
  },

  "useCases": {
    "$comment": "Maps active text use cases to the two standard Longhouse lanes.",
    "text": {
      "session_title": "deepseek/deepseek-v4-flash",
      "summarization": "TIER_2",
      "summary_update": "TIER_3"
    },
    "realtime": {
      "voice_conversation": "TIER_1",
      "voice_test": "TIER_2"
    }
  },

  "defaults": {
    "text": {
      "primary": "TIER_1",
      "test": "TIER_3"
    },
    "realtime": {
      "production": "TIER_1",
      "test": "TIER_2"
    }
  },

  "embedding": {
    "$comment": "Pinned local retrieval space. Query and document vectors are comparable only when every field below matches.",
    "default": {
      "provider": "local-onnx",
      "model": "google/embeddinggemma-300m",
      "dims": 256,
      "dtype": "float32",
      "normalization": "l2",
      "truncation": "prefix",
      "outputName": "sentence_embedding",
      "queryPrefix": "task: search result | query: ",
      "documentPrefix": "title: none | text: ",
      "legacyModels": [
        "qwen/qwen3-embedding-8b"
      ],
      "artifact": {
        "repository": "onnx-community/embeddinggemma-300m-ONNX",
        "revision": "5090578d9565bb06545b4552f76e6bc2c93e4a66",
        "directory": "embeddinggemma-300m-onnx-5090578d-fp16",
        "files": [
          {
            "path": "onnx/model_fp16.onnx",
            "bytes": 655263,
            "sha256": "dcfaf21ff7cae91af9295366ac0d7352efcadeaf7deefb98f82d5056502d0bf2"
          },
          {
            "path": "onnx/model_fp16.onnx_data",
            "bytes": 617434112,
            "sha256": "1cd839755aa8e24d5af7f16ef275b12d717a4401bb009099b8c17e4156d3d5d5"
          },
          {
            "path": "tokenizer.json",
