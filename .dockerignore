# Root-context Docker builds should only see the files used by
# `docker/runtime.dockerfile` and `docker/backend.dockerfile`.
# Keep this as an explicit allowlist so large sibling trees do not
# accidentally inflate hosted smoke and image build loops.
*
!.dockerignore
!bun.lock

!server/
!server/**

!web/
!web/**

!config/
config/*
!config/models.json
!config/tool-tiers.json

!schemas/
schemas/*
!schemas/managed_providers.yml

# The provider-factory image uses a named Longhouse context to verify the
# exact native control-path sources. Keep that context narrow; never send the
# Rust build tree or the rest of the engine into a container build.
!engine/
engine/*
!engine/src/
engine/src/*
!engine/src/codex_bridge.rs
!engine/src/claude_channel_control.rs
!engine/src/claude_channel_server.rs
!engine/src/config.rs
!engine/src/cursor_helm_launcher.rs
!engine/src/longhouse.rs
!engine/src/main.rs
!engine/src/managed_launch_lifecycle.rs
!engine/src/managed_launch_payload.rs
!engine/src/managed_bridge_scan.rs
!engine/src/managed_resume_scan.rs
!engine/src/opencode_bridge.rs
!engine/src/opencode_control.rs

!docker/
docker/*
!docker/backend.dockerfile
!docker/runtime.dockerfile
!docker/entrypoint.sh

# Build identity is generated per-build by scripts/build/generate_build_identity.py
# and staged directly into server/zerg/build_identity.json, so it rides along
# via the `!server/` allowlist above — no extra .build/ allowlist needed.

# Ignore heavyweight/generated content inside the allowlisted trees.
server/.venv
server/.venv/**
server/.uv_cache
server/.uv_cache/**
server/.uv_tmp
server/.uv_tmp/**
server/venv
server/venv/**
server/dist
server/dist/**
server/data
server/data/**
server/.pytest_cache
server/.pytest_cache/**
server/.ruff_cache
server/.ruff_cache/**
server/.mypy_cache
server/.mypy_cache/**
server/.coverage
server/htmlcov
server/htmlcov/**
server/.hypothesis
server/.hypothesis/**
server/__pycache__
server/__pycache__/**
server/**/__pycache__
server/**/__pycache__/**
server/**/*.pyc
server/**/*.pyo

web/node_modules
web/node_modules/**
web/dist
web/dist/**
web/.vite
web/.vite/**
web/coverage
web/coverage/**
web/playwright-report
web/playwright-report/**
web/test-results
web/test-results/**
