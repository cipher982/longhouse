    {"url": "http://box.ts.net.evil.com", "allow_insecure_http": true, "verdict": "refused_public"},

    {"url": "http://192.168.1.20:8080", "allow_insecure_http": false, "verdict": "refused_lan"},
    {"url": "http://192.168.1.20:8080", "allow_insecure_http": true, "verdict": "allowed_warn"},
