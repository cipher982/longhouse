    {"url": "http://100.64.0.1:8080/some/path?q=1#frag", "allow_insecure_http": false, "verdict": "allowed"},
    {"url": "  http://100.64.0.1:8080/  ", "allow_insecure_http": false, "verdict": "allowed"},
    {"url": "http://user@100.64.0.1:8080", "allow_insecure_http": false, "verdict": "allowed"},
    {"url": "http://100.64.0.1@evil.example:8080", "allow_insecure_http": false, "verdict": "refused_public"},
