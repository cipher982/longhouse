{
  "version": 1,
  "rule": "Native clients send the device token and every transcript to the Runtime Host address. https is always allowed. Plaintext http is allowed to loopback (localhost, 127.0.0.0/8, ::1) and to Tailscale addresses (IPv4 100.64.0.0/10, IPv6 fd7a:115c:a1e0::/48, names ending .ts.net), because WireGuard encrypts that transport. Plaintext http to a LAN or private address (RFC1918, link-local 169.254.0.0/16 and fe80::/10, IPv6 unique-local fc00::/7, names ending .local) is refused unless the user opted in (--allow-insecure-http or LONGHOUSE_ALLOW_INSECURE_HTTP=1, persisted in machine state as allow_insecure_http), and is then allowed with a warning. Every other plaintext http address is refused, opt-in or not. The host is judged after userinfo, case-folded, brackets and one trailing dot removed; only canonical dotted-quad IPv4 and standard IPv6 literals count as addresses (IPv4-mapped IPv6 is not), anything else is a name. Non-canonical numeric forms (100.64.1, octal, hex) are deliberately not vectors: a client that normalizes them through a URL parser judges the address it will dial, and one that does not treats them as a name and refuses. A http URL with a backslash in it is invalid. Every client (Python, Rust engine, macOS Desktop app, iOS app) reads this file in its tests; change the rule here first.",
  "verdicts": {
    "allowed": "connect; no warning",
    "allowed_warn": "connect, and print the insecure-transport warning every time",
    "refused_lan": "refuse; the error names the opt-in",
    "refused_public": "refuse; https only",
    "invalid": "not an http(s) address this rule can judge"
  },
  "hosts": [
    {"host": "localhost", "class": "loopback"},
    {"host": "LOCALHOST", "class": "loopback"},
    {"host": "127.0.0.1", "class": "loopback"},
    {"host": "127.255.255.255", "class": "loopback"},
    {"host": "::1", "class": "loopback"},
    {"host": "localhost.attacker.example", "class": "public"},
    {"host": "128.0.0.1", "class": "public"},
    {"host": "::ffff:127.0.0.1", "class": "public"},
    {"host": "::", "class": "public"},
    {"host": "0.0.0.0", "class": "public"},

    {"host": "100.63.255.255", "class": "public"},
    {"host": "100.64.0.0", "class": "tailscale"},
    {"host": "100.64.0.1", "class": "tailscale"},
    {"host": "100.100.100.100", "class": "tailscale"},
    {"host": "100.127.255.255", "class": "tailscale"},
    {"host": "100.128.0.0", "class": "public"},
    {"host": "fd7a:115c:a1e0::1", "class": "tailscale"},
    {"host": "fd7a:115c:a1e0:ab12:4843:cd96:6278:9ab1", "class": "tailscale"},
    {"host": "FD7A:115C:A1E0:FFFF:FFFF:FFFF:FFFF:FFFF", "class": "tailscale"},
    {"host": "fd7a:115c:a1df:ffff:ffff:ffff:ffff:ffff", "class": "lan"},
    {"host": "fd7a:115c:a1e1::", "class": "lan"},
    {"host": "::ffff:100.64.0.1", "class": "public"},
    {"host": "box.ts.net", "class": "tailscale"},
    {"host": "box.tail1234.ts.net", "class": "tailscale"},
    {"host": "BOX.TAIL1234.TS.NET", "class": "tailscale"},
    {"host": "box.tail1234.ts.net.", "class": "tailscale"},
    {"host": "ts.net", "class": "public"},
    {"host": ".ts.net", "class": "public"},
    {"host": "evilts.net", "class": "public"},
    {"host": "box.ts.net.evil.com", "class": "public"},
    {"host": "box.ts.network", "class": "public"},

    {"host": "10.0.0.0", "class": "lan"},
    {"host": "10.255.255.255", "class": "lan"},
    {"host": "172.16.0.0", "class": "lan"},
    {"host": "172.31.255.255", "class": "lan"},
    {"host": "172.15.255.255", "class": "public"},
    {"host": "172.32.0.0", "class": "public"},
    {"host": "192.168.0.1", "class": "lan"},
    {"host": "192.168.255.255", "class": "lan"},
    {"host": "192.167.255.255", "class": "public"},
    {"host": "192.169.0.0", "class": "public"},
    {"host": "169.254.1.1", "class": "lan"},
    {"host": "169.253.255.255", "class": "public"},
    {"host": "fe80::1", "class": "lan"},
    {"host": "febf::1", "class": "lan"},
    {"host": "fec0::1", "class": "public"},
    {"host": "fc00::1", "class": "lan"},
    {"host": "fd12:3456:789a::1", "class": "lan"},
    {"host": "fe00::1", "class": "public"},
    {"host": "mybox.local", "class": "lan"},
    {"host": "MyBox.LOCAL", "class": "lan"},
    {"host": "mybox.local.", "class": "lan"},
    {"host": "local", "class": "public"},
    {"host": ".local", "class": "public"},
    {"host": "mybox.localhost", "class": "public"},
    {"host": "nas", "class": "public"},

    {"host": "8.8.8.8", "class": "public"},
    {"host": "demo.longhouse.ai", "class": "public"},
    {"host": "2001:db8::1", "class": "public"},
    {"host": "", "class": "public"}
  ],
  "urls": [
    {"url": "https://demo.longhouse.ai", "allow_insecure_http": false, "verdict": "allowed"},
    {"url": "https://you.longhouse.ai/", "allow_insecure_http": false, "verdict": "allowed"},
