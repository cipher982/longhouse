# ==============================================================================
# LONGHOUSE ENVIRONMENT VARIABLES
# Configuration for the Longhouse Runtime Host (mission control for CLI agent sessions)
# ==============================================================================
# Copy to `.env` at repo root and adjust values for your environment.
#
# Required variables are marked [REQUIRED].

# ==============================================================================
# DATABASE [REQUIRED]
# ==============================================================================
# SQLite database (default for development and OSS)
# Path is expanded at runtime: ~/.longhouse/ becomes /home/user/.longhouse/
DATABASE_URL=sqlite:///~/.longhouse/longhouse.db

# Longhouse core is SQLite-only. For an alternate location:
# DATABASE_URL=sqlite:////var/lib/longhouse/longhouse.db

# ==============================================================================
# OPENAI / LLM [REQUIRED for AI features]
# ==============================================================================
OPENAI_API_KEY="sk-your-key-here"

# Optional: Groq API key for fast inference (Qwen, Llama models)
# GROQ_API_KEY="gsk_your-key-here"

# Optional: cost budgets in cents (0 disables)
# DAILY_COST_PER_USER_CENTS=500
# DAILY_COST_GLOBAL_CENTS=10000

# Optional: restrict non-admin users to specific models (csv)
ALLOWED_MODELS_NON_ADMIN=gpt-4o-mini

# Emit per-token chunks over WebSocket during agent runs
LLM_TOKEN_STREAM=true

# Disable LLM calls entirely (for testing)
# LLM_DISABLED=1

# ==============================================================================
# AUTHENTICATION
# ==============================================================================
# Development shortcut: set to "1" to bypass all auth checks.
# WARNING: this makes every session and transcript readable without a login.
# Only set it to "1" on a local machine you are the sole user of.
AUTH_DISABLED=0

# Google OAuth (required when AUTH_DISABLED=0)
GOOGLE_CLIENT_ID="change-me.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="change-me-secret"

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# JWT signing secret (HS256) - use strong random value in production
JWT_SECRET="dev-secret"

# Internal API secret for backend-to-backend calls (e.g., continuation endpoints)
# Use strong random value in production
INTERNAL_API_SECRET="dev-internal-secret"

# Fernet encryption key for sensitive data (generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_SECRET=<generate-with-cryptography-fernet-or-longhouse-serve>

# ==============================================================================
# PORT CONFIGURATION
# ==============================================================================
# Nginx entry point (reverse-proxy)
JARPXY_PORT=30080

# Direct service ports (published by dev compose; useful for debugging)
BACKEND_PORT=47300
FRONTEND_PORT=47200

# Internal service ports (Docker network only, used by nginx)
ZERG_BACKEND_PORT=8000
ZERG_FRONTEND_PORT=5173

# ==============================================================================
# FRONTEND (VITE_ prefix exposes to browser)
# ==============================================================================
# API/WebSocket URLs (set automatically by Docker Compose for dev)
# For production, set VITE_WS_BASE_URL to your domain with wss:// protocol
# VITE_API_BASE_URL=/api
# VITE_WS_BASE_URL=wss://yourdomain.com

# Enable frontend auth guard (should match AUTH_DISABLED inverse)
VITE_AUTH_ENABLED=false

# Google OAuth client ID for frontend
# VITE_GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com

# Umami analytics (optional - runtime config, no rebuild required)
# UMAMI_WEBSITE_ID="your-website-id"
# UMAMI_SCRIPT_SRC="https://analytics.yourdomain.com/script.js"
# UMAMI_DOMAINS="yourdomain.com"
# UMAMI_TAG="prod"

# ==============================================================================
# USER LIMITS / ADMIN
# ==============================================================================
# Single-tenant enforcement (1 = enforced, 0 = allow multi-tenant)
SINGLE_TENANT=1

# Cap on browser sign-ups when SINGLE_TENANT=0. Must be a positive integer;
# it is ignored in single-tenant mode and for addresses in ADMIN_EMAILS.
MAX_USERS=1

# Comma-separated admin emails (bypass caps, elevated privileges)
# IMPORTANT: Set to your actual email before deploying, or leave empty for OSS mode
ADMIN_EMAILS=""

# Development shortcut: gives the auto-provisioned dev user the ADMIN role and
# serves /docs, /redoc and /openapi.json. Leave it unset on anything reachable
# by someone else. `make dev` turns it on for you (scripts/dev-docker.sh
# defaults it to 1), so you only need this line for a hand-run `longhouse serve`.
# DEV_ADMIN=1

# Smoke test service account secret (for automated testing)
# SMOKE_TEST_SECRET="your-smoke-test-secret-here"

# ==============================================================================
# EMAIL (OPTIONAL - instance mail via AWS SES)
# ==============================================================================
# Longhouse sends operational mail only: the runner-offline alerts raised by
# the maintenance sweep, addressed to the runner's owner. There is no
# user-facing mail feature.
#
# These keys resolve from the encrypted `email_secrets` table first and fall
# back to the environment, so Settings -> Integrations overrides whatever you
# set here. Sending needs the two credentials plus FROM_EMAIL. AWS_SES_REGION
# defaults to us-east-1, and NOTIFY_EMAIL is the fallback recipient for callers
# that do not name one.
# AWS_SES_ACCESS_KEY_ID="AKIA..."
# AWS_SES_SECRET_ACCESS_KEY="your-secret-key"
# AWS_SES_REGION="us-east-1"
# FROM_EMAIL="noreply@yourdomain.com"
# NOTIFY_EMAIL="you@yourdomain.com"

# ==============================================================================
# NOTIFICATIONS (OPTIONAL)
# ==============================================================================
# Discord webhook posted to when a new user signs up. Both must be set.
DISCORD_WEBHOOK_URL=""
DISCORD_ENABLE_ALERTS=0

# ==============================================================================
# RUNTIME SETTINGS
# ==============================================================================
ENVIRONMENT=development

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# CORS: comma-separated origins. Leave empty to derive them from
# APP_PUBLIC_URL/PUBLIC_SITE_URL (localhost when neither is set). Never "*".
ALLOWED_CORS_ORIGINS=""

# Public URL for callbacks and links (used in emails, runner install commands, etc)
# - If you're running `make dev` (nginx at JARPXY_PORT): use http://localhost:30080
# - If you're hitting backend directly (BACKEND_PORT): use http://localhost:47300
APP_PUBLIC_URL="http://localhost:30080"

# Runner docker image used in runner install commands (defaults to GHCR)
# RUNNER_DOCKER_IMAGE="ghcr.io/cipher982/longhouse-runner:latest"

# Historical import safety controls. Live storage traffic never consumes these
# budgets. Byte rate/burst and tenant ceiling are disabled when set to 0; disk
# watermarks remain active by default. Keep burst >= the largest admitted unit.
# LONGHOUSE_HISTORICAL_BYTES_PER_SECOND=0
# LONGHOUSE_HISTORICAL_BURST_BYTES=0
# LONGHOUSE_TENANT_STORED_BYTES_CEILING=0
# LONGHOUSE_HISTORICAL_MIN_FREE_BYTES=5368709120
# LONGHOUSE_HISTORICAL_MIN_FREE_RATIO=0.05

# Storage worker lanes are isolated; these tune bounded concurrency without
# allowing repair traffic to borrow live capacity.
# LONGHOUSE_STORAGE_RAW_LIVE_WORKERS=2
# LONGHOUSE_STORAGE_RAW_REPAIR_WORKERS=1
# LONGHOUSE_STORAGE_RAW_READ_WORKERS=1
# LONGHOUSE_STORAGE_RENDER_LIVE_WORKERS=1
# LONGHOUSE_STORAGE_RENDER_REPAIR_WORKERS=1
# LONGHOUSE_STORAGE_RENDER_READ_WORKERS=2
# LONGHOUSE_STORAGE_RAW_QUEUE_MULTIPLIER=2
# LONGHOUSE_STORAGE_RENDER_QUEUE_MULTIPLIER=2
# LONGHOUSE_STORAGE_TELEMETRY_REFRESH_SECONDS=15
